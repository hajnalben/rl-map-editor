{
  "name": "RL Map Editor",
  "short_name": "RL Maps",
  "description": "Build and edit Rocket League workshop maps in the browser",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1114",
  "theme_color": "#1a1d23",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
